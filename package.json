{
  "name": "inkle",
  "version": "0.1.0",
  "private": true,
  "description": "inkle 워크스페이스 루트. 앱은 apps/, 공유 코드는 packages/ (ADR-010)",
  "scripts": {
    "dev": "pnpm --filter @inkle/web dev",
    "build": "pnpm --filter @inkle/web build",
    "api": "pnpm --filter @inkle/api dev",
    "worker": "pnpm --filter @inkle/worker start",
    "db:migrate": "pnpm --filter @inkle/api db:migrate",
    "job:enqueue": "pnpm --filter @inkle/api job:enqueue",
    "collect": "pnpm --filter @inkle/api collect",
    "collect:report": "pnpm --filter @inkle/api collect:report",
    "lint": "eslint . && pnpm design:lint",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --exclude \"**/infrastructure/**\"",
    "test:e2e": "playwright test",
    "e2e:abandon": "pnpm --filter @inkle/api e2e:abandon",
    "design:lint": "design.md lint DESIGN.md"
  },
  "devDependencies": {
    "@google/design.md": "0.4.0",
    "@mozilla/readability": "^0.6.0",
    "@playwright/test": "^1.65.1",
    "@shadcn/lint": "^0.2.5",
    "@types/node": "^22.20.5",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitest/browser-playwright": "5.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "linkedom": "^0.18.15",
    "next": "16.4.6",
    "playwright": "^1.65.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@9.15.6"
}
